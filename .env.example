# Selects the entry in config/regions.ts for this deployment.
NEXT_PUBLIC_REGION_SLUG=china

# Public application URL for canonical links and auth redirects.
NEXT_PUBLIC_SITE_URL=https://example.com

# Required JSON map of administrator emails to unique passwords.
# Example: {"admin@example.com":"replace-with-a-long-unique-password"}
MANAGER_CREDENTIALS=
MANAGER_SESSION_SECRET=

# Optional social connections. Modules stay hidden until configured.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
X_BEARER_TOKEN=
X_USER_ID=
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Shared staking integration. Never commit private keys.
NEXT_PUBLIC_CONFLUX_NETWORK=mainnet
NEXT_PUBLIC_STAKING_CONTRACT=
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
