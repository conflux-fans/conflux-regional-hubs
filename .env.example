# Public identity for this deployment. Every regional domain is a separate
# deployment target from the same repository.
NEXT_PUBLIC_REGION_SLUG=africa
NEXT_PUBLIC_SITE_URL=https://kudihub.com

# Comma-separated regional editors. Keep this server-side.
REGIONAL_EDITOR_EMAILS=lead@example.com,editor@example.com

# Official social-feed credentials. Profile links and safe fallback cards work
# without these; automatic Instagram/X feeds require the provider credentials.
INSTAGRAM_ACCESS_TOKEN=
X_BEARER_TOKEN=

# YouTube RSS works without a token when the manager supplies a /channel/UC… URL.
YOUTUBE_API_KEY=

# Production media and infrastructure placeholders.
R2_BUCKET_NAME=
CFX_NETWORK_ID=
CFX_RPC_URL=
CFX_STAKING_CONTRACT_ADDRESS=
CFX_WALLETCONNECT_PROJECT_ID=
