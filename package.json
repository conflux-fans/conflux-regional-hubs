{
  "name": "conflux-community-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "auth:setup": "node scripts/setup-admin-auth.mjs",
    "staking:verify": "node --experimental-strip-types scripts/verify-staking.ts",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern .next",
    "db:migrate": "node --experimental-strip-types scripts/migrate-database.ts"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "next": "16.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "Conflux Community Hub"
}
